NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=

# Azure Translator.  Resource: "Linguistics" (region eastus).
#
# ENDPOINT must be this resource's OWN host, NOT the shared global
# https://api.cognitive.microsofttranslator.com/.
#
# >> Do not copy this value off the portal's "Text Translation" line. <<
# For a resource with a custom subdomain (this one), that line shows the
# GLOBAL host, and the global host rejects a perfectly valid key with
# HTTP 401 / error 401001. The correct host is on the "Document
# Translation" line instead - take the origin from there and append
# /translator/text/v3.0/ yourself for the text API.
#
# The reason that misconfiguration is so expensive to debug: Azure returns
# 401001 both for "wrong host for this resource" and for a completely
# fabricated key - byte-identical responses, confirmed by sending the
# literal string "definitely-not-a-key". So a 401 alone can never tell you
# which one you have, and the natural reaction (rotate the key) is wasted
# effort on a key that was always fine.
#
# Two safeguards exist because of that:
#   - lib/azure-endpoint.ts rejects the global host by name, so this fails
#     at startup with an explanation instead of at runtime as a phantom
#     auth error.
#   - `npm run translate-messages -- --check` sends a real request to the
#     resource endpoint and tells you whether it's the endpoint or the key.
#     Run it before concluding anything about a 401.
#
# The trailing slash matters: the call sites resolve the path with
# new URL("translate", endpoint), which silently drops "v3.0" without it.
# It's normalized for you, but paste it with the slash anyway.
#
# The region header is optional on this endpoint (200 with and without) but
# required on the global one; keep it set regardless.
AZURE_TRANSLATOR_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/translator/text/v3.0/
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Groq (Whisper transcription for audio/video posts).
GROQ_API_KEY=

# Vercel sets this itself for cron jobs; needed locally to call
# /api/cron/* by hand.
CRON_SECRET=
